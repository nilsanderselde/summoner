// Generated from {{project_path_str}}

pub const PRESET_TOML: &str = "{{preset_toml}}";
pub const INSTRUMENT_NAME: &str = "{{instrument_name}}";

static DESCRIPTOR: clap_plugin_descriptor = clap_plugin_descriptor {
    clap_version: clap_sys::version::CLAP_VERSION,
    id: b"{{plugin_id}}\0".as_ptr() as *const c_char,
    name: b"{{plugin_name}}\0".as_ptr() as *const c_char,
    vendor: b"Summoner\0".as_ptr() as *const c_char,
    url: b"\0".as_ptr() as *const c_char,
    manual_url: b"\0".as_ptr() as *const c_char,
    support_url: b"\0".as_ptr() as *const c_char,
    version: b"{{plugin_version}}\0".as_ptr() as *const c_char,
    description: b"Generated by Summoner\0".as_ptr() as *const c_char,
    features: [ptr::null(); 1].as_ptr() as *const *const c_char,
};

pub struct PluginInstance {
    sample_rate: f64,
    active: bool,
}

impl PluginInstance {
    pub fn new() -> Self {
        Self {
            sample_rate: 44100.0,
            active: false,
        }
    }

    pub fn process(&mut self, process: *const clap_process) -> i32 {
        if process.is_null() {
            return CLAP_PROCESS_CONTINUE;
        }
        unsafe {
            let proc = &*process;
            let frames = proc.frames_count as usize;
            if proc.audio_outputs_count > 0 && !proc.audio_outputs.is_null() {
                let out = &*proc.audio_outputs;
                if !out.data32.is_null() && out.channel_count >= 2 {
                    let left_ptr = *out.data32;
                    let right_ptr = *out.data32.add(1);
                    if !left_ptr.is_null() && !right_ptr.is_null() {
                        let left_slice = std::slice::from_raw_parts_mut(left_ptr as *mut f32, frames);
                        let right_slice = std::slice::from_raw_parts_mut(right_ptr as *mut f32, frames);
                        left_slice.fill(0.0);
                        right_slice.fill(0.0);
                    }
                }
            }
        }
        CLAP_PROCESS_CONTINUE
    }
}

pub struct PluginWrapper {
    pub c_plugin: clap_plugin,
    pub instance: Mutex<PluginInstance>,
}

unsafe extern "C" fn plugin_init(plugin: *const clap_plugin) -> bool {
    !plugin.is_null()
}

unsafe extern "C" fn plugin_destroy(plugin: *const clap_plugin) {
    if !plugin.is_null() {
        let wrapper_ptr = plugin as *mut PluginWrapper;
        let _ = Box::from_raw(wrapper_ptr);
    }
}

unsafe extern "C" fn plugin_activate(
    plugin: *const clap_plugin,
    sample_rate: f64,
    _min_frames_count: u32,
    _max_frames_count: u32,
) -> bool {
    if plugin.is_null() {
        return false;
    }
    let wrapper = &*(plugin as *const PluginWrapper);
    if let Ok(mut inst) = wrapper.instance.lock() {
        inst.sample_rate = sample_rate;
        inst.active = true;
    }
    true
}

unsafe extern "C" fn plugin_deactivate(plugin: *const clap_plugin) {
    if !plugin.is_null() {
        let wrapper = &*(plugin as *const PluginWrapper);
        if let Ok(mut inst) = wrapper.instance.lock() {
            inst.active = false;
        }
    }
}

unsafe extern "C" fn plugin_start_processing(plugin: *const clap_plugin) -> bool {
    !plugin.is_null()
}

unsafe extern "C" fn plugin_stop_processing(_plugin: *const clap_plugin) {}

unsafe extern "C" fn plugin_reset(_plugin: *const clap_plugin) {}

unsafe extern "C" fn plugin_process(
    plugin: *const clap_plugin,
    process: *const clap_process,
) -> i32 {
    if plugin.is_null() {
        return CLAP_PROCESS_CONTINUE;
    }
    let wrapper = &*(plugin as *const PluginWrapper);
    if let Ok(mut inst) = wrapper.instance.lock() {
        inst.process(process)
    } else {
        CLAP_PROCESS_CONTINUE
    }
}

unsafe extern "C" fn plugin_get_extension(
    _plugin: *const clap_plugin,
    _id: *const c_char,
) -> *const std::ffi::c_void {
    ptr::null()
}

unsafe extern "C" fn plugin_on_main_thread(_plugin: *const clap_plugin) {}

extern "C" fn get_plugin_count(_factory: *const clap_plugin_factory) -> u32 {
    1
}

extern "C" fn get_plugin_descriptor(
    _factory: *const clap_plugin_factory,
    index: u32,
) -> *const clap_plugin_descriptor {
    if index == 0 {
        &DESCRIPTOR
    } else {
        ptr::null()
    }
}

extern "C" fn create_plugin(
    _factory: *const clap_plugin_factory,
    _host: *const clap_sys::host::clap_host,
    plugin_id: *const c_char,
) -> *const clap_plugin {
    if plugin_id.is_null() {
        return ptr::null();
    }
    let id_str = unsafe { std::ffi::CStr::from_ptr(plugin_id) }.to_str().unwrap_or("");
    let expected_id = format!("com.summoner.{}", "{{plugin_name}}".to_lowercase());
    if id_str != expected_id {
        return ptr::null();
    }

    let wrapper = Box::new(PluginWrapper {
        c_plugin: clap_plugin {
            desc: &DESCRIPTOR,
            plugin_data: ptr::null_mut(),
            init: Some(plugin_init),
            destroy: Some(plugin_destroy),
            activate: Some(plugin_activate),
            deactivate: Some(plugin_deactivate),
            start_processing: Some(plugin_start_processing),
            stop_processing: Some(plugin_stop_processing),
            reset: Some(plugin_reset),
            process: Some(plugin_process),
            get_extension: Some(plugin_get_extension),
            on_main_thread: Some(plugin_on_main_thread),
        },
        instance: Mutex::new(PluginInstance::new()),
    });

    let raw = Box::into_raw(wrapper);
    unsafe {
        (*raw).c_plugin.plugin_data = raw as *mut _;
        &(*raw).c_plugin as *const clap_plugin
    }
}

static FACTORY: clap_plugin_factory = clap_plugin_factory {
    get_plugin_count: Some(get_plugin_count),
    get_plugin_descriptor: Some(get_plugin_descriptor),
    create_plugin: Some(create_plugin),
};

extern "C" fn get_factory(factory_id: *const c_char) -> *const std::ffi::c_void {
    if factory_id.is_null() {
        return ptr::null();
    }
    let factory_id_str = unsafe { std::ffi::CStr::from_ptr(factory_id) }.to_str().unwrap_or("");
    if factory_id_str == "clap.plugin-factory" {
        &FACTORY as *const _ as *const std::ffi::c_void
    } else {
        ptr::null()
    }
}

#[no_mangle]
pub static clap_entry: clap_sys::entry::clap_plugin_entry = clap_sys::entry::clap_plugin_entry {
    clap_version: clap_sys::version::CLAP_VERSION,
    init: None,
    deinit: None,
    get_factory: Some(get_factory),
};
